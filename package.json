{
  "name": "react-ops-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Incident console: Protobuf contract, ConnectRPC on Node, React with TanStack Query",
  "scripts": {
    "generate": "buf generate",
    "lint:proto": "buf lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/",
    "dev": "vite",
    "build": "vite build",
    "start": "node server/main.ts",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-node": "^2.3.0",
    "@connectrpc/connect-query": "^2.3.1",
    "@connectrpc/connect-web": "^2.3.0",
    "@tanstack/react-query": "^5.108.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
